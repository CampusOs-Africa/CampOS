# CampusOS backend environment template.
# Copy to .env and fill in real values. Do NOT commit real secrets.

# Runtime
APP_ENV=development
DEBUG=false
PORT=8000

# URLs
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:8000
# Comma-separated allowed CORS origins (in addition to FRONTEND_URL)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database
DATABASE_URL=sqlite:///./campusos.db

# Auth — REQUIRED in production. Generate a long random string.
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Optional comma-separated rotated keys
JWT_SECRET_KEY_ROTATION=

# Set to true ONLY for local/demo one-click login. Must be false in production.
ALLOW_DEMO_LOGIN=false

# Rate limiting (single-instance in-memory; Redis optional)
USE_REDIS_RATE_LIMIT=false
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_DEFAULT_PER_MINUTE=100
RATE_LIMIT_SENSITIVE_PER_MINUTE=20
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_OTP_PER_MINUTE=5

# Email OTP (Resend). Leave blank in dev (USE_MOCK_EMAIL_OTP=true).
RESEND_API_KEY=
USE_MOCK_EMAIL_OTP=true
EMAIL_OTP_EXPIRE_SECONDS=600
EMAIL_OTP_MAX_ATTEMPTS=3

# Storage (Cloudinary). Leave blank in dev (USE_MOCK_CLOUDINARY=true).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
USE_MOCK_CLOUDINARY=true
MAX_UPLOAD_SIZE=5242880

# Blockchain — mock by default. Do not enable real mode without configuration.
USE_MOCK_BLOCKCHAIN=true
ALLOW_MOCK_BLOCKCHAIN_IN_PRODUCTION=false
QUAI_RPC_URL=
QUAI_NETWORK=
QUAI_CHAIN_ID=
QUAI_CONTRACT_ADDRESS=
QUAI_ESCROW_CONTRACT_ADDRESS=
QUAI_PRIVATE_KEY=

# QR signature secret (defaults to JWT_SECRET if unset)
QR_SECRET_KEY=

# Blip Pay (Phase 6). Webhook HMAC secret REQUIRED in production.
BLIP_API_URL=
BLIP_PAY_API_KEY=
BLIP_PAY_WEBHOOK_SECRET=
BLIP_PAY_WEBHOOK_SECRET_ROTATION=
USE_MOCK_BLIP_PAY=true

# Phase 6 payments
BLIP_API_URL=
BLIP_API_KEY=
BLIP_PAY_API_KEY=
# Comma-separated rotated webhook secrets
BLIP_PAY_WEBHOOK_SECRET_ROTATION=
USE_MOCK_BLIP_PAY=true
