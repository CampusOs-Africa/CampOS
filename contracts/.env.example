# CampusOS Smart Contract Environment — Testnet + Mainnet
# Copy this to contracts/.env and fill in real values.
# NEVER commit this file. NEVER reuse a mainnet key for testnet or vice versa.

# ─────────────────────────────────────────────────────────────
# Orchard Testnet (Cyprus-1 zone) — used by --network quaiTestnet
# and by `QUAI_TARGET_NETWORK=testnet` in scripts/deployQuai.ts
# ─────────────────────────────────────────────────────────────
QUAI_TESTNET_RPC_URL=https://orchard.rpc.quai.network/cyprus1
QUAI_TESTNET_CHAIN_ID=15000
# Fund this address first: https://orchard.faucet.quai.network/
QUAI_TESTNET_PRIVATE_KEY=0x87aa222fa6a6d645645b7eaee8e491f504464487185874f8f34128e17246d6e4

# ─────────────────────────────────────────────────────────────
# Quai Mainnet (Cyprus-1 zone) — used by --network quaiMainnet
# and by `QUAI_TARGET_NETWORK=mainnet` in scripts/deployQuai.ts
# Leave QUAI_MAINNET_PRIVATE_KEY empty until you are actually
# ready to deploy with real funds — an empty key makes the
# quaiMainnet hardhat network refuse to sign anything.
# ─────────────────────────────────────────────────────────────
QUAI_MAINNET_RPC_URL=https://rpc.quai.network/cyprus1
QUAI_MAINNET_CHAIN_ID=9
QUAI_MAINNET_PRIVATE_KEY=0x87aa222fa6a6d645645b7eaee8e491f504464487185874f8f34128e17246d6e4

# Required extra guardrail before scripts/deployQuai.ts will touch mainnet.
# Leave unset/blank normally; only set to "yes" for the actual mainnet run.
CONFIRM_MAINNET_DEPLOY=