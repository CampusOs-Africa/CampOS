# CampusOS Enterprise Production Environment Template (.env.production.example)
# Use with AWS Secrets Manager, HashiCorp Vault, or Railway Sealed Secrets

# --- Application Environment ---
ENVIRONMENT=production
PORT=8000
WEB_CONCURRENCY=4

# --- Managed PostgreSQL 16 & Redis 7 ---
DATABASE_URL=postgresql+psycopg2://campusos_prod_user:CHANGE_ME_STRONG_PASSWORD@postgres.internal:5432/campusos_prod?sslmode=require
REDIS_URL=redis://default:CHANGE_ME_REDIS_PASSWORD@redis.internal:6379/0
USE_REDIS_RATE_LIMIT=True
RATE_LIMIT_DEFAULT_PER_MINUTE=100
RATE_LIMIT_SENSITIVE_PER_MINUTE=30

# --- Production Cryptographic Secrets (256-bit random hex) ---
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_ME_256_BIT_RANDOM_SECRET_KEY_FOR_JWT_SIGNING
JWT_SECRET_KEY_ROTATION=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
QR_SECRET_KEY=CHANGE_ME_256_BIT_RANDOM_SECRET_KEY_FOR_QR_HMAC

# --- Quai Network EVM Production ---
QUAI_RPC_URL=https://rpc.quai.network
QUAI_CONTRACT_ADDRESS=0x1111111111111111111111111111111111111111
QUAI_ESCROW_CONTRACT_ADDRESS=0x2222222222222222222222222222222222222222
QUAI_PRIVATE_KEY=CHANGE_ME_QUAI_DEPLOYER_PRIVATE_KEY
QUAI_CHAIN_ID=9000
USE_MOCK_BLOCKCHAIN=False

# --- Blip Pay Production Checkout & Webhook Secrets ---
BLIP_PAY_API_KEY=live_blip_pay_api_key_xxx
BLIP_PAY_WEBHOOK_SECRET=CHANGE_ME_256_BIT_BLIP_WEBHOOK_HMAC_SECRET
BLIP_PAY_WEBHOOK_SECRET_ROTATION=
USE_MOCK_BLIP_PAY=False

# --- Resend Email API ---
RESEND_API_KEY=re_live_resend_api_key_xxx
EMAIL_OTP_EXPIRE_SECONDS=600
EMAIL_OTP_MAX_ATTEMPTS=3
USE_MOCK_EMAIL_OTP=False

# --- Cloudinary Production Storage ---
CLOUDINARY_CLOUD_NAME=live_cloud_name
CLOUDINARY_API_KEY=live_cloudinary_key
CLOUDINARY_API_SECRET=live_cloudinary_secret
USE_MOCK_CLOUDINARY=False

# --- CORS Production Allowlist ---
ALLOWED_CORS_ORIGINS=https://campusos.vercel.app,https://campusos.ng,https://www.campusos.ng
